{
  "name": "sts2stats",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "verify:local": "node scripts/verify-local.mjs",
    "check:version": "node scripts/check-version.mjs",
    "verify": "node scripts/verify-desktop.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:web": "node scripts/build-web.mjs",
    "preview:web": "node scripts/serve-web.mjs",
    "test:e2e:web": "playwright test --config playwright.web.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8",
    "zod": "^4.5.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "typescript-eslint": "^8.42.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "@tauri-apps/cli": "^2.8.4",
    "@playwright/test": "^1.55.0",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "typescript": "6.0.3",
    "fake-indexeddb": "6.2.4",
    "fflate": "0.8.2"
  }
}
